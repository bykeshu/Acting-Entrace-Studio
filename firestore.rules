rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed data model: users/{uid}/events/{eventId} only.
    // uid is the Firebase Auth UID; eventId is a client UUID (immutable).
    // kind: one of the tracker entities; entityId: nonempty string <= 512;
    // action: put or delete; payload: JSON string <= 50000, empty for delete;
    // schemaVersion: integer 1; createdAt: server timestamp (immutable).
    // No user-profile or public collection is created by this app.
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function uidUnchanged(uid) { return request.auth.uid == uid; }
    function uidNotModified(uid) { return request.auth.uid == uid; }
    function isValidEvent() {
      let d = request.resource.data;
      return d.keys().hasAll(['kind','entityId','action','payload','schemaVersion','createdAt'])
        && d.keys().hasOnly(['kind','entityId','action','payload','schemaVersion','createdAt'])
        && d.kind is string
        && d.kind in ['task','session','test','production','dailyReview','topic','evidence','roadmap']
        && d.entityId is string && d.entityId.size() > 0 && d.entityId.size() <= 512
        && d.action is string && d.action in ['put','delete']
        && d.payload is string && d.payload.size() <= 50000
        && (d.action == 'put' || d.payload == '')
        && d.schemaVersion is int && d.schemaVersion == 1
        && d.createdAt is timestamp && d.createdAt == request.time;
    }
    match /users/{uid}/events/{eventId} {
      allow get, list: if isOwner(uid);
      allow create: if isOwner(uid) && uidUnchanged(uid)
        && eventId.matches('^[0-9a-fA-F-]{36}$') && isValidEvent();
      // Events are append-only. Validation is still named on the update path;
      // no client can change or remove a previously accepted event.
      allow update: if isOwner(uid) && uidNotModified(uid) && isValidEvent() && false;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
